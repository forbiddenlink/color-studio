{
  "name": "color-studio",
  "version": "1.0.2",
  "description": "A powerful color manipulation tool for designers and developers",
  "scripts": {
    "start": "webpack serve --mode development",
    "watch": "webpack -w --mode development",
    "build": "webpack --mode production",
    "check": "pnpm run biome:check && pnpm test && pnpm run build",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write",
    "security": "pnpm audit --audit-level high",
    "audit": "pnpm audit --audit-level high",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "posthog-js": "^1.418.12",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@biomejs/biome": "^2.5.11",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "style-loader": "^4.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "private": false,
  "pnpm": {
    "overrides": {
      "webpack-dev-server": ">=5.2.1 <7",
      "on-headers": ">=1.1.0 <2",
      "qs": ">=6.14.2 <7",
      "webpack": ">=5.104.1 <6",
      "ajv": ">=8.18.0 <9",
      "minimatch": ">=3.1.4 <4",
      "serialize-javascript": ">=7.0.5 <8",
      "vite": ">=8.0.5 <9",
      "protobufjs": "^7.6.1",
      "dompurify": ">=3.4.13 <4",
      "follow-redirects": ">=1.16.0 <2",
      "@babel/plugin-transform-modules-systemjs": ">=7.27.0 <9",
      "uuid": ">=11.1.1 <12",
      "postcss": ">=8.5.23 <9",
      "uuid@11": ">=11.1.1 <12",
      "fast-uri": ">=2.4.4 <3",
      "postcss-selector-parser": ">=7.1.3 <8"
    }
  },
  "packageManager": "pnpm@10.32.1"
}
