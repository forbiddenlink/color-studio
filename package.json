{
  "name": "color-studio",
  "version": "1.2.0",
  "description": "A powerful color manipulation tool for designers and developers",
  "scripts": {
    "start": "webpack serve --mode development",
    "watch": "webpack -w --mode development",
    "build": "webpack --mode production",
    "check": "pnpm run biome:check && pnpm test && pnpm run build",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write",
    "security": "pnpm audit --audit-level high",
    "audit": "pnpm audit --audit-level high",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "posthog-js": "^1.422.5",
    "webpack": "^5.110.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@babel/preset-env": "8.0.7",
    "@biomejs/biome": "2.6.5",
    "babel-loader": "10.1.1",
    "css-loader": "7.1.5",
    "dotenv": "17.4.2",
    "jsdom": "30.1.3",
    "style-loader": "4.0.0",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  },
  "license": "MIT",
  "private": false,
  "packageManager": "pnpm@10.34.9"
}
